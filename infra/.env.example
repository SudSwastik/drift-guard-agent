DRIFT_GUARD_ENVIRONMENT=local
DRIFT_GUARD_SERVICE_NAME=drift-guard-agent
DRIFT_GUARD_LOG_LEVEL=INFO
DRIFT_GUARD_BLOCKING_ENABLED=false
DRIFT_GUARD_OBSERVATION_FAILURE_MODE=best_effort
DRIFT_GUARD_OBSERVATION_RETENTION_DAYS=14
DRIFT_GUARD_DRIFT_MIN_SAMPLES=10
DRIFT_GUARD_DRIFT_MIN_COUNT=3
DRIFT_GUARD_DRIFT_MIN_RATE=0.2
# Set a generated PostgreSQL password (at least 16 characters) in the ignored .env.
DRIFT_GUARD_POSTGRES_PASSWORD=
DRIFT_GUARD_POSTGRES_ADMIN_PASSWORD=
DRIFT_GUARD_OBSERVATION_HMAC_KEY=
# Compose runs PostgreSQL privately and persists it in the postgres-data volume.
# An external PostgreSQL server can be selected using DRIFT_GUARD_DATABASE_URL.
# Set a stable DRIFT_GUARD_OBSERVATION_HMAC_KEY before rotating the API key.
# Run python3 infra/scripts/configure-env.py to generate missing secrets locally.
# Staging/production requires DRIFT_GUARD_API_KEY with at least 32 characters.
# Generate it locally; keep it in the ignored .env file, never in Git.
